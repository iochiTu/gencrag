# Copy to .env and edit.

DATABASE_URL=postgresql://rag:rag@localhost:5432/kbeauty
# Docker host port; keep this and the port in DATABASE_URL in sync.
POSTGRES_PORT=5432

# ollama = local test | bedrock = Amazon Bedrock | foundry = Microsoft Foundry | mock = no model (CI)
LLM_PROVIDER=ollama
EMBED_DIM=1024
# Ask reasoning models (DeepSeek Flash, GPT Luna / GPT-5+, Claude Sonnet 5.5, Qwen3) not to think.
# Thinking tokens are billed as output and slow answers; set false only to compare quality.
DISABLE_THINKING=true

# --- Local (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_PARSE_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_DISABLE_THINKING=true
OLLAMA_TIMEOUT_S=300

# --- Amazon Bedrock (production) ---
# Check exact ids / inference profiles: aws bedrock list-inference-profiles --region ap-northeast-2
AWS_REGION=ap-northeast-2
BEDROCK_CHAT_MODEL=anthropic.claude-sonnet-5
BEDROCK_PARSE_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=cohere.embed-v4:0
# Alternatives: qwen.qwen3-235b-a22b-2507-v1:0, deepseek.v3.2, amazon.titan-embed-text-v2:0

# --- Microsoft Foundry (LLM_PROVIDER=foundry) ---
# Foundry portal > your project > Models + endpoints. Use DEPLOYMENT names (case-sensitive), not model names.
# Works with models served on the OpenAI-compatible endpoint: GPT-4.1 / GPT-5 family, DeepSeek, Llama, Grok, ...
FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
FOUNDRY_AUTH=key            # key = API key below; entra = Microsoft Entra ID (az login / managed identity; pip install azure-identity)
FOUNDRY_API_KEY=
FOUNDRY_CHAT_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_PARSE_DEPLOYMENT=   # optional cheaper/faster deployment for reading notes and descriptions
FOUNDRY_EMBED_DEPLOYMENT=text-embedding-3-large
FOUNDRY_TIMEOUT_S=120

# --- Retrieval (ranking weights are set in the admin portal at /admin) ---
RETRIEVE_K=30
SHORTLIST_SIZE=20

# --- Admin portal (/admin). Leave ADMIN_PASSWORD empty to disable the portal. ---
# Generate a SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD=change-me
SECRET_KEY=replace-with-a-long-random-string
ADMIN_SESSION_HOURS=12

# --- Staff chat app (http://localhost:8000/) ---
STAFF_SESSION_DAYS=30       # how long phones stay signed in
BRAND_NAME=Gen C Beauty
BRAND_LOGO_URL=https://cdn11.bigcommerce.com/s-kzkmuqjqk9/images/stencil/original/download1_1659212301__04676.original.png

# Currency of the price / cost columns
CURRENCY=USD
# Ambiguous dates in imported files (03/04/2027): MDY = month/day/year, DMY = day/month/year
DATE_ORDER=MDY
